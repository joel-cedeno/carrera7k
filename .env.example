# Copia este archivo como .env y ajusta los valores.

# Dirección y puerto del servidor. En producción, detrás de un proxy, suele usarse HOST=127.0.0.1.
HOST=127.0.0.1
PORT=5173

# Archivo SQLite (debe estar en un disco persistente y respaldarse).
DB_PATH=data/inscripciones.db

# Cupos totales (2.000 por disposición de la Viceministra, 20-10-2026; el documento original decía 1.500).
TOTAL_CUPOS=2000

# Ventana de inscripción (ISO 8601 con zona horaria de Ecuador). Vacío = abiertas sin restricción.
# El documento prevé del 1 al 11 de noviembre de 2026; confirmar fechas definitivas antes de activar.
# INSCRIPCIONES_INICIO=2026-11-01T00:00:00-05:00
# INSCRIPCIONES_FIN=2026-11-11T23:59:59-05:00

# Límite de inscripciones por IP en una ventana de minutos (oficinas pueden compartir IP).
LIMITE_INSCRIPCIONES_IP=30
LIMITE_VENTANA_MIN=10

# 1 si el servidor está detrás de un proxy que envía X-Forwarded-For (nginx, Caddy…).
TRUST_PROXY=0

# Máximo de conexiones simultáneas en tiempo real; por encima, los navegadores consultan cada 15 s.
MAX_CONEXIONES_SSE=5000

# ── Boletos con QR ─────────────────────────────────────────────────
# La clave que firma los boletos vive en la base de datos (se crea sola). Este archivo PEM Ed25519 solo se
# importa si la base de datos aún no tiene clave (p. ej. al migrar a un servidor nuevo). Si trae una clave
# distinta a la guardada, el servidor no arranca para no invalidar los boletos emitidos.
BOLETOS_CLAVE=data/boletos-ed25519.pem

# Puntos de control del día del evento: id:Nombre visible, separados por coma.
PUNTOS_CONTROL=kit:Entrega de kit,salida:Ingreso a la salida

# Duración de la sesión de un moderador (horas).
SESION_HORAS=12

# Dirección pública definitiva del sitio. Con ella, los QR de los boletos apuntan siempre aquí (aunque el sitio
# se abra desde otra dirección) y npm run qr-sitio la usa por defecto. Definirla ANTES de abrir inscripciones.
# URL_PUBLICA=https://…
