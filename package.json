{
  "name": "carrera-7k-inscripciones",
  "private": true,
  "version": "0.2.0",
  "description": "Landing e inscripciones de la Carrera Atlética 7K – TypeScript sin framework, SQLite y tiempo real (SSE)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps build/index.js",
    "exportar": "node --env-file-if-exists=.env build/exportar.js",
    "moderadores": "node --env-file-if-exists=.env build/moderadores.js",
    "boletos": "node --env-file-if-exists=.env build/boletos-cli.js",
    "qr-sitio": "node --env-file-if-exists=.env build/qr-sitio.js"
  },
  "devDependencies": {
    "@fontsource/metropolis": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3"
  }
}
